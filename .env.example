# Environment for Geiger Property. Copy to .env (or .env.local) and fill in; never commit real values.

# Supabase (browser runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_URL=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, used by migrations only (npm run db:*)
STRING_URI=
CRON_SECRET=
JOBS_ALERT_EMAILS=
GEIGER_EMAIL_API_KEY=
GEIGER_EMAIL_API_URL=

# Screening data protection (RISK-02), server only.
# Keys the HMAC fingerprints kept for duplicate and fraud checks (never the values). Random, at least 32 bytes: openssl rand -hex 32
# Changing it makes earlier fingerprints unmatchable.
SCREENING_FINGERPRINT_KEY=
# AES-256-GCM key for any screening value that must be stored (the current design stores none). 32 bytes: openssl rand -hex 32
SCREENING_DATA_KEY=
